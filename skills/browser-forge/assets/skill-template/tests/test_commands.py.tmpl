import json
from importlib import import_module
from pathlib import Path

manifest_data = json.loads((Path(__file__).parents[1] / "manifest.json").read_text())
package = "browser_forge_" + manifest_data["id"].split(".", 1)[1].replace("-", "_")
cli_module = import_module(package + ".cli")
manifest_module = import_module(package + ".manifest")
handler_module = import_module(package + ".handler")


def test_builtin_commands_present():
    parser = cli_module.build_parser(manifest_module.load_manifest())
    choices = next(action for action in parser._actions if action.dest == "selected_command").choices
    assert {"doctor", "auth-status", "describe"}.issubset(choices)


def test_execute_steps_orders_calls():
    command = {
        "id": "update-order",
        "steps": [
            {"id": "load", "request": "GET /orders/{order_id}", "depends_on": []},
            {
                "id": "update",
                "request": "POST /orders/{order_id}",
                "body": {"state": "{state}"},
                "depends_on": ["load"],
            },
        ],
    }
    calls = []

    class FakeClient:
        def request(self, method, path, body=None):
            calls.append((method, path, body))
            return {"sequence": len(calls)}

    result = cli_module._execute_steps(command, {"order_id": "O-1", "state": "ready"}, FakeClient())
    assert calls == [("GET", "/orders/O-1", None), ("POST", "/orders/O-1", {"state": "ready"})]
    assert result["output"] == {"sequence": 2}


def test_handler_registration_roundtrip():
    calls: list[dict] = []

    @handler_module.command("__test_command")
    def _run(inputs, ctx):
        calls.append({"inputs": inputs})
        return {"echo": inputs}

    assert handler_module.get("__test_command") is _run
    assert "__test_command" in handler_module.registered_ids()

    class FakeClient:
        auth_metadata: dict = {}
        class config:
            secrets: tuple = ()

        def request(self, *a, **kw):
            raise AssertionError("handler should not need HTTP for this test")

    from types import SimpleNamespace
    fake_client = SimpleNamespace(
        auth_metadata={},
        config=SimpleNamespace(secrets=()),
    )
    result = _run({"x": 1}, handler_module.HandlerContext(client=fake_client, logger=None))
    assert result == {"echo": {"x": 1}}


def test_describe_default(monkeypatch, capsys):
    monkeypatch.setattr(cli_module, "load_manifest", lambda: manifest_data)
    assert cli_module.main(["describe"]) == 0
    payload = json.loads(capsys.readouterr().out)
    assert payload["command"] == "describe"
    assert payload["ok"] is True
