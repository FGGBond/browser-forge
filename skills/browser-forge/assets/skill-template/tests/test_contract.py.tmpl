import json
import logging
from importlib import import_module
from pathlib import Path

import pytest

manifest = json.loads((Path(__file__).parents[1] / "manifest.json").read_text())
package = "browser_forge_" + manifest["id"].split(".", 1)[1].replace("-", "_")
http_module = import_module(package + ".http")
config_module = import_module(package + ".config")
envelope_module = import_module(package + ".envelope")
Client = http_module.Client
ClientError = http_module.ClientError
RedactingFilter = http_module.RedactingFilter
load_config = config_module.load_config
success = envelope_module.success
failure = envelope_module.failure


def test_success_envelope_shape():
    result = success("doctor", {"ready": True})
    assert set(result) == {
        "spec_version", "ok", "command", "status", "data", "artifacts", "auth", "next_actions"
    }
    assert result["ok"] is True


def test_failure_envelope_shape():
    result = failure("get-item", "INVALID_ARGUMENT", "id is required", True)
    assert result["ok"] is False
    assert result["error"] == {
        "code": "INVALID_ARGUMENT",
        "message": "id is required",
        "recoverable": True,
    }


def test_network_disabled(monkeypatch):
    monkeypatch.setenv("BROWSER_FORGE_DISABLE_NETWORK", "1")
    cfg = load_config(manifest)
    client = Client(cfg)
    with pytest.raises(ClientError) as raised:
        client.request("GET", "/")
    assert raised.value.code == "NETWORK_DISABLED"


def test_target_not_allowed():
    cfg = load_config(manifest)
    if not cfg.allowed_hosts:
        pytest.skip("manifest declares no allowlist")
    client = Client(cfg)
    with pytest.raises(ClientError) as raised:
        client._validate_target("https://evil.example.com/")
    assert raised.value.code == "TARGET_NOT_ALLOWED"


def test_redacting_filter():
    header_line = "Cookie" ": " "leaked-value"
    record = logging.LogRecord("t", logging.WARNING, __file__, 1, header_line, (), None)
    RedactingFilter().filter(record)
    assert "leaked-value" not in record.getMessage()


def test_default_headers_load():
    fake = dict(manifest)
    fake["transport"] = {"default_headers": {"x-proxy-opts": "abc"}}
    cfg = load_config(fake)
    assert cfg.default_headers == {"x-proxy-opts": "abc"}
