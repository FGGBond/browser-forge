    )


def test_sso_security_flow(tmp_path, monkeypatch, capsys):
    db_path = tmp_path / "Cookies"
    write_jdme_db(db_path, extra_rows=(
        ("focus-team-id", TEAM_ID, b"", ".jd.com", "/", 1, 0),
        ("me_token", "<HOSTILE-COOKIE-SECRET>", b"", ".attacker.test", "/", 1, 0),
        ("jdsec_client_info", "<EXPIRED-COOKIE-SECRET>", b"", ".jd.com", "/", 1, 500),
        ("jdsec_client_info", "<BAD-PATH-COOKIE-SECRET>", b"", ".jd.com", "bad", 1, 0),
    ))
    (tmp_path / "global.json").write_text(json.dumps({"DeviceId": DEVICE_UUID}))
    (tmp_path / "login.json").write_text(json.dumps({"KEY_RISK_JS_EID": DEVICE_EID}))
    monkeypatch.setenv("USER", DEVICE_ACCOUNT)
    with fake_sso_server(get_code_redirect=True) as (base, state):
        provider = jdme_provider(base, db_path, tmp_path / "cache")

        session = provider.resolve(base + "/target?client_id=attacker-app")

    output = capsys.readouterr()
    assert session.provider == "jdme_sso"
    assert session.fallback_used is False
    assert session.expires_at == 15_400
    assert state["union_redirect"]
    decoded_redirect = base64.urlsafe_b64decode(
        state["union_redirect"] + "=" * (-len(state["union_redirect"]) % 4)
    ).decode("utf-8")
    assert parse_qs(decoded_redirect) == {
        "client_id": ["orders-app"],
        "state": ["trusted-state"],
    }
    assert state["union_form"].get("client_id") is None
    assert state["union_form"]["jme_auth_code"] == [AUTH_CODE]
    assert {"appName", "appid", "body", "client", "clientVersion", "d_brand", "functionId", "t", "uuid"} <= state["code_form"]
    assert {"functionid", "logintype", "x-device-type", "x-language", "x-tenant-code"} <= state["code_headers"]
    assert state["getcode_cookies"] == {"me_token", "focus-team-id"}
    assert not ({"cookie", "x-sso-deviceaccountname", "x-sso-devicedomain", "x-team-id"} & state["redirect_headers"])
    assert state["redirect_cookies"] == set()
    assert "getcode_flow" in state["target_cookies"]
    assert state["paths"] == [
        "/get-code",
        "/get-code-final",
        "/target",
        "/oidc/authorize",
        "/sso/login",
        "/jdme-union-login",
        "/callback",
        "/probe",
    ]
    assert {item.name for item in session.cookie_jar} == {"ssa.orders-app"}
    assert "ssa.orders-app" in state["probe_cookies"]
    for secret in (
        ME_TOKEN, AUTH_CODE, GETCODE_FLOW, SSO_TICKET, TARGET_SESSION,
        DEVICE_EID, DEVICE_UUID, DEVICE_ACCOUNT, TEAM_ID,
        "<HOSTILE-COOKIE-SECRET>", "<EXPIRED-COOKIE-SECRET>", "<BAD-PATH-COOKIE-SECRET>",
    ):
        assert secret not in output.out + output.err


