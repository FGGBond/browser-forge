def test_non_jd_skips_jdme():
    jdme_instantiations = []
    browser_calls = []

    for target_url in (
        "https://api.example.test/list",
        "https://eviljd.com/list",
        "https://jd.com.attacker.test/list",
    ):
        resolver = AuthResolver(
            "browser_forge.order-tools",
            allowed_domains=("api.example.test", "eviljd.com", "jd.com.attacker.test"),
            jdme_factory=lambda: jdme_instantiations.append(target_url),
            browser_factory=lambda: FakeProvider("browser_cookie", browser_calls),
        )

        assert resolver.resolve(target_url).provider == "browser_cookie"

    assert jdme_instantiations == []
    assert [call[1] for call in browser_calls] == [
        "https://api.example.test/list",
        "https://eviljd.com/list",
        "https://jd.com.attacker.test/list",
    ]
    assert is_jd_target("https://sub.orders.jd.com/", ("orders.jd.com",)) is True
    assert is_jd_target("https://orders.jd.com.attacker.test/", ("orders.jd.com",)) is False


