import json
from importlib import import_module
from pathlib import Path

import pytest

manifest = json.loads((Path(__file__).parents[1] / "manifest.json").read_text())
package = "browser_forge_" + manifest["id"].split(".", 1)[1].replace("-", "_")
auth_module = import_module(package + ".auth")
cli_module = import_module(package + ".cli")
config_module = import_module(package + ".config")
AuthError = auth_module.AuthError
AuthResolver = auth_module.AuthResolver
AuthSession = auth_module.AuthSession


def test_none_strategy_returns_empty_session():
    resolver = AuthResolver("none")
    session = resolver.resolve("https://api.example.test/")
    assert session.cookie_header == ""
    assert session.provider == "none"


def test_erp_sso_missing_when_not_configured(monkeypatch):
    monkeypatch.delenv("ERP_SSO_LOGIN_HOME", raising=False)
    monkeypatch.delenv("ERP_SSO_LOGIN_PATH", raising=False)
    resolver = AuthResolver("jd-internal")
    report = resolver.doctor()
    erp = next(p for p in report["providers"] if p["name"] == "erp-sso-login")
    assert erp["available"] is False


def test_browser_cookie_env_override(monkeypatch):
    monkeypatch.setenv("BROWSER_FORGE_COOKIE_HEADER", "session=abc; other=def")
    resolver = AuthResolver("browser-cookie")
    session = resolver.resolve("https://api.example.test/")
    assert "session=abc" in session.cookie_header
    assert session.provider == "env"


def test_required_cookie_missing(monkeypatch):
    monkeypatch.setenv("BROWSER_FORGE_COOKIE_HEADER", "session=abc")
    resolver = AuthResolver("browser-cookie", required_cookies=("must_have",))
    with pytest.raises(AuthError) as raised:
        resolver.resolve("https://api.example.test/")
    assert raised.value.code == "REQUIRED_COOKIE_MISSING"


def test_auth_metadata_never_leaks_value(monkeypatch, capsys):
    monkeypatch.setenv("BROWSER_FORGE_COOKIE_HEADER", "session=secret-value-xyz")
    resolver = AuthResolver("browser-cookie")
    session = resolver.resolve("https://api.example.test/")
    meta = session.metadata()
    assert "secret-value-xyz" not in json.dumps(meta)
    assert "session" in meta["cookie_names"]


def test_jd_internal_falls_back_to_browser_cookie(monkeypatch):
    monkeypatch.setenv("BROWSER_FORGE_COOKIE_HEADER", "session=abc")
    monkeypatch.delenv("ERP_SSO_LOGIN_HOME", raising=False)
    monkeypatch.delenv("ERP_SSO_LOGIN_PATH", raising=False)
    resolver = AuthResolver("jd-internal")
    session = resolver.resolve("https://foo.jd.com/")
    assert session.cookie_header.startswith("session=")


def test_doctor_reports_strategy_and_providers(monkeypatch, capsys):
    monkeypatch.setenv("BROWSER_FORGE_COOKIE_HEADER", "session=abc")
    assert cli_module.main(["doctor"]) == 0
    payload = json.loads(capsys.readouterr().out)
    assert payload["ok"] is True
    assert "auth_strategy" in payload["data"]
    assert "auth_doctor" in payload["data"]


def test_target_urls_populated(tmp_path):
    cfg = config_module.load_config(manifest)
    # The template's manifest may have zero target_urls if generated with none.
    assert isinstance(cfg.target_urls, tuple)
