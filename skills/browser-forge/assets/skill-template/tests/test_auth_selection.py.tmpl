def test_decryption(tmp_path, monkeypatch):
    from cryptography.hazmat.primitives import padding
    from cryptography.hazmat.primitives.ciphers import Cipher, algorithms, modes
    from cryptography.hazmat.primitives.ciphers.aead import AESGCM

    key = b"0123456789abcdef"
    plaintext = b"synthetic-cookie-value"
    monkeypatch.setattr(jdme_module, "_os_key", lambda _path, system=None: key)

    padder = padding.PKCS7(128).padder()
    padded = padder.update(plaintext) + padder.finalize()
    encryptor = Cipher(algorithms.AES(key), modes.CBC(b" " * 16)).encryptor()
    mac_value = b"v10" + encryptor.update(padded) + encryptor.finalize()
    assert decrypt_cookie(mac_value, tmp_path / "Cookies", system="Darwin") == plaintext.decode()

    hashed = hashlib.sha256(b".jd.com").digest() + plaintext
    padder = padding.PKCS7(128).padder()
    padded = padder.update(hashed) + padder.finalize()
    encryptor = Cipher(algorithms.AES(key), modes.CBC(b" " * 16)).encryptor()
    current_value = b"v10" + encryptor.update(padded) + encryptor.finalize()
    assert decrypt_cookie(
        current_value,
        tmp_path / "Cookies",
        system="Darwin",
        host_key=".jd.com",
        db_version=24,
    ) == plaintext.decode()

    nonce = b"synthetic-iv"
    windows_value = b"v10" + nonce + AESGCM(key).encrypt(nonce, plaintext, None)
    assert decrypt_cookie(windows_value, tmp_path / "Cookies", system="Windows") == plaintext.decode()

    with pytest.raises(JdmeSsoError) as raised:
        decrypt_cookie(mac_value, tmp_path / "Cookies", system="Plan9")
    assert raised.value.code == "JDME_DECRYPTION_ERROR"
    assert raised.value.recoverable is False


