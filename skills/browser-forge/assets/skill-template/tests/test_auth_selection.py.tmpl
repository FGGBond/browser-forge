def write_jdme_db(path, *, plain="<REDACTED>", encrypted=b""):
    db = sqlite3.connect(path)
    db.execute(
        "CREATE TABLE cookies "
        "(name TEXT, value TEXT, encrypted_value BLOB, host_key TEXT, path TEXT, "
        "is_secure INTEGER, expires_utc INTEGER)"
    )
    db.execute(
        "INSERT INTO cookies VALUES (?, ?, ?, ?, ?, ?, ?)",
        ("me_token", plain, encrypted, ".jd.com", "/", 1, 0),
    )
    db.commit()
    db.close()


@contextmanager
def fake_sso_server(*, code_ok=True, union_ok=True, callback_ok=True, probe_ok=True):
    state = {"client_id": None, "paths": [], "code_form": set(), "code_headers": set()}

    class Handler(BaseHTTPRequestHandler):
        def log_message(self, _format, *_args):
            return

        def _cookie(self, name):
            return f"{name}=<REDACTED>" in self.headers.get("Cookie", "")

        def _redirect(self, path, cookie_name=None):
            self.send_response(302)
            self.send_header("Location", path)
            if cookie_name:
                self.send_header("Set-Cookie", f"{cookie_name}=<REDACTED>; Path=/")
            self.end_headers()

        def do_GET(self):
            state["paths"].append(self.path.split("?", 1)[0])
            if self.path == "/target":
                self._redirect("/oidc/authorize?client_id=orders-app", "flow")
                return
            if self.path.startswith("/oidc/authorize"):
                self.send_response(200)
                self.end_headers()
                return
            if self.path == "/callback":
                if not callback_ok or not self._cookie("flow") or not self._cookie("sso.jd.com"):
                    self.send_response(403)
                    self.end_headers()
                    return
                self.send_response(200)
                self.send_header("Set-Cookie", "ssa.orders=<REDACTED>; Path=/")
                self.end_headers()
                return
            if self.path == "/probe":
                ok = all(self._cookie(name) for name in ("flow", "sso.jd.com", "ssa.orders"))
                self.send_response(200 if ok and probe_ok else 401)
                self.end_headers()
                return
            self.send_response(404)
            self.end_headers()

        def do_POST(self):
            length = int(self.headers.get("Content-Length", "0"))
            form = parse_qs(self.rfile.read(length).decode("utf-8"))
            state["paths"].append(self.path)
            if self.path == "/get-code":
                state["code_form"] = set(form)
                state["code_headers"] = {name.lower() for name in self.headers}
                self.send_response(200 if self._cookie("me_token") and code_ok else 401)
                self.send_header("Content-Type", "application/json")
                self.end_headers()
                payload = b'{"code":0,"data":{"code":"<REDACTED>"}}' if code_ok else b'{"code":1}'
                self.wfile.write(payload)
                return
            if self.path == "/jdme-union-login":
                state["client_id"] = form.get("client_id", [None])[0]
                if not union_ok or form.get("jme_auth_code") != ["<REDACTED>"]:
                    self.send_response(401)
                    self.end_headers()
                    return
                self._redirect("/callback", "sso.jd.com")
                return
            self.send_response(404)
            self.end_headers()

    server = ThreadingHTTPServer(("127.0.0.1", 0), Handler)
    thread = threading.Thread(target=server.serve_forever, daemon=True)
    thread.start()
    try:
        yield f"http://127.0.0.1:{server.server_port}", state
    finally:
        server.shutdown()
        thread.join()
        server.server_close()


def test_sso_one_jar(tmp_path, capsys):
    db_path = tmp_path / "Cookies"
    write_jdme_db(db_path)
    with fake_sso_server() as (base, state):
        provider = JdmeSsoProvider(
            "browser_forge.order-tools",
            allowed_domains=("127.0.0.1",),
            endpoints=JdmeEndpoints(
                get_code_url=base + "/get-code",
                union_login_url=base + "/jdme-union-login",
                probe_url=base + "/probe",
            ),
            cookie_db_finder=lambda: db_path,
            cache_root=tmp_path / "cache",
            now=lambda: 1_000,
        )

        session = provider.resolve(base + "/target")

    output = capsys.readouterr()
    assert session.provider == "jdme_sso"
    assert session.fallback_used is False
    assert session.expires_at == 15_400
    assert state["client_id"] == "orders-app"
    assert {"appName", "appid", "body", "client", "clientVersion", "d_brand", "functionId", "t", "uuid"} <= state["code_form"]
    assert {"functionid", "logintype", "x-device-type", "x-language", "x-tenant-code"} <= state["code_headers"]
    assert state["paths"] == [
        "/get-code",
        "/target",
        "/oidc/authorize",
        "/jdme-union-login",
        "/callback",
        "/probe",
    ]
    assert {item.name for item in session.cookie_jar} == {"flow", "sso.jd.com", "ssa.orders"}
    assert "<REDACTED>" not in output.out + output.err


def test_db_candidates():
    mac = db_candidates(home=Path("/Users/current"), system="Darwin", environ={})
    win = db_candidates(
        home=Path("C:/Users/current"),
        system="Windows",
        environ={"APPDATA": "C:/Users/current/AppData/Roaming"},
    )
    linux = db_candidates(home=Path("/home/current"), system="Linux", environ={})
    wsl = db_candidates(
        home=Path("/home/current"),
        system="Linux",
        environ={"WSL_DISTRO_NAME": "Ubuntu"},
        wsl_users=(Path("/mnt/c/Users/current"),),
    )

    assert Path("/Users/current/Library/Application Support/ME/Network/Cookies") in mac
    assert Path("C:/Users/current/AppData/Roaming/ME/Network/Cookies") in win
    assert Path("/home/current/.config/ME/Network/Cookies") in linux
    assert Path("/mnt/c/Users/current/AppData/Roaming/ME/Network/Cookies") in wsl


