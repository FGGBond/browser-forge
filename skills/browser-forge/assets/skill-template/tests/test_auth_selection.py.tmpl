def test_db_decrypt_hook(tmp_path):
    path = tmp_path / "Cookies"
    write_jdme_db(path, plain="", encrypted=b"v10<REDACTED>")
    calls = []
    with fake_sso_server() as (base, _state):
        provider = JdmeSsoProvider(
            "browser_forge.order-tools",
            allowed_domains=("127.0.0.1",),
            endpoints=JdmeEndpoints(
                get_code_url=base + "/get-code",
                union_login_url=base + "/jdme-union-login",
                probe_url=base + "/probe",
            ),
            cookie_db_finder=lambda: path,
            decryptor=lambda value, db_path: calls.append((value[:3], db_path.name)) or "<REDACTED>",
            cache_root=tmp_path / "cache",
        )

        session = provider.resolve(base + "/target")

    assert session.provider == "jdme_sso"
    assert calls == [(b"v10", "Cookies")]

    with fake_sso_server() as (base, _state):
        broken = JdmeSsoProvider(
            "browser_forge.order-tools",
            allowed_domains=("127.0.0.1",),
            endpoints=JdmeEndpoints(
                get_code_url=base + "/get-code",
                union_login_url=base + "/jdme-union-login",
            ),
            cookie_db_finder=lambda: path,
            decryptor=lambda _value, _path: (_ for _ in ()).throw(ValueError("programming failure")),
            cache_root=tmp_path / "broken",
        )
        with pytest.raises(JdmeSsoError) as raised:
            broken.resolve(base + "/target")
    assert raised.value.code == "JDME_DECRYPTION_ERROR"
    assert "programming failure" not in str(raised.value)


def test_jdme_error_codes(tmp_path):
    missing = JdmeSsoProvider(
        "browser_forge.order-tools",
        allowed_domains=("orders.jd.com",),
        cookie_db_finder=lambda: None,
        cache_root=tmp_path / "missing",
    )
    with pytest.raises(JdmeSsoError) as raised:
        missing.resolve("https://orders.jd.com/")
    assert raised.value.code == "JDME_NOT_LOGGED_IN"

    with pytest.raises(JdmeSsoError) as raised:
        missing.resolve("https://eviljd.com/")
    assert raised.value.code == "TARGET_NOT_ALLOWED"
    assert raised.value.recoverable is False

    with pytest.raises(JdmeSsoError) as raised:
        missing.resolve("http://orders.jd.com/")
    assert raised.value.code == "TLS_REQUIRED"
    assert raised.value.recoverable is False

    path = tmp_path / "Cookies"
    write_jdme_db(path)
    with fake_sso_server(code_ok=False) as (base, _state):
        rejected = JdmeSsoProvider(
            "browser_forge.order-tools",
            allowed_domains=("127.0.0.1",),
            endpoints=JdmeEndpoints(
                get_code_url=base + "/get-code",
                union_login_url=base + "/jdme-union-login",
                probe_url=base + "/probe",
            ),
            cookie_db_finder=lambda: path,
            cache_root=tmp_path / "rejected",
        )
        with pytest.raises(JdmeSsoError) as raised:
            rejected.resolve(base + "/target")
    assert raised.value.code == "SSO_EXCHANGE_FAILED"

    with fake_sso_server(probe_ok=False) as (base, _state):
        failed_probe = JdmeSsoProvider(
            "browser_forge.order-tools",
            allowed_domains=("127.0.0.1",),
            endpoints=JdmeEndpoints(
                get_code_url=base + "/get-code",
                union_login_url=base + "/jdme-union-login",
                probe_url=base + "/probe",
            ),
            cookie_db_finder=lambda: path,
            cache_root=tmp_path / "probe",
        )
        with pytest.raises(JdmeSsoError) as raised:
            failed_probe.resolve(base + "/target")
    assert raised.value.code == "TARGET_SESSION_FAILED"

    with fake_sso_server(callback_ok=False) as (base, _state):
        failed_callback = JdmeSsoProvider(
            "browser_forge.order-tools",
            allowed_domains=("127.0.0.1",),
            endpoints=JdmeEndpoints(
                get_code_url=base + "/get-code",
                union_login_url=base + "/jdme-union-login",
                probe_url=base + "/probe",
            ),
            cookie_db_finder=lambda: path,
            cache_root=tmp_path / "callback",
        )
        with pytest.raises(JdmeSsoError) as raised:
            failed_callback.resolve(base + "/target")
    assert raised.value.code == "TARGET_SESSION_FAILED"


def test_auth_boundaries(tmp_path):
    created = []
    resolver = AuthResolver(
        "browser_forge.order-tools",
        allowed_domains=("orders.jd.com",),
        jdme_factory=lambda: created.append("jdme_sso"),
        browser_factory=lambda: created.append("browser_cookie"),
    )

    with pytest.raises(AuthTargetError) as raised:
        resolver.resolve("https://orders.jd.com.attacker.test/")

    assert raised.value.code == "TARGET_NOT_ALLOWED"
    assert raised.value.recoverable is False
    assert created == []

    provider = JdmeSsoProvider(
        "browser_forge.order-tools",
        allowed_domains=("127.0.0.1",),
        endpoints=JdmeEndpoints(
            get_code_url="https://attacker.test/get-code",
            union_login_url="https://ssa.jd.com/sso/jdmeUnionLogin",
        ),
        cookie_db_finder=lambda: None,
        cache_root=tmp_path / "blocked",
    )
    with pytest.raises(JdmeSsoError) as raised:
        provider.resolve("http://127.0.0.1/target")
    assert raised.value.code == "TARGET_NOT_ALLOWED"
    assert raised.value.recoverable is False


def test_chain_error_redacted():
    resolver = AuthResolver(
        "browser_forge.order-tools",
        allowed_domains=("orders.jd.com",),
        jdme_factory=lambda: FakeProvider(
            "jdme_sso",
            [],
            error=JdmeSsoError("JDME_NOT_LOGGED_IN"),
        ),
        browser_factory=lambda: FakeProvider(
            "browser_cookie",
            [],
            error=BrowserCookieError([{"browser": "edge", "error": "PermissionError"}]),
        ),
    )

    with pytest.raises(AuthUnavailableError) as raised:
        resolver.resolve("https://orders.jd.com/")

    assert raised.value.code == "AUTH_" "UNAVAILABLE"
    assert raised.value.attempted_providers == ("jdme_sso", "browser_cookie")
    assert "PermissionError" not in str(raised.value)
    assert "Cookie" not in str(raised.value)

    programming_error = ValueError("programming failure")
    resolver = AuthResolver(
        "browser_forge.order-tools",
        allowed_domains=("api.example.test",),
        browser_factory=lambda: FakeProvider("browser_cookie", [], error=programming_error),
    )
    with pytest.raises(AuthProviderError) as raised:
        resolver.resolve("https://api.example.test/")
    assert raised.value.code == "AUTH_PROVIDER_ERROR"
    assert raised.value.recoverable is False
    assert "programming failure" not in str(raised.value)


