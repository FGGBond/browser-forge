TARGET_DOMAINS = list(manifest.get("auth", {}).get("target_domains", []))
BASE_HOST = TARGET_DOMAINS[0] if TARGET_DOMAINS else "api.example.test"
BASE_URL = f"https://{BASE_HOST}"

ME_TOKEN = "<ME-TOKEN-SECRET>"
AUTH_CODE = "<AUTH-CODE-SECRET>"
