def write_jdme_db(path, *, plain=ME_TOKEN, encrypted=b"", extra_rows=()):
    db = sqlite3.connect(path)
    db.execute(
        "CREATE TABLE cookies "
        "(name TEXT, value TEXT, encrypted_value BLOB, host_key TEXT, path TEXT, "
        "is_secure INTEGER, expires_utc INTEGER)"
    )
    db.execute(
        "INSERT INTO cookies VALUES (?, ?, ?, ?, ?, ?, ?)",
        ("me_token", plain, encrypted, ".jd.com", "/", 1, 0),
    )
    db.executemany("INSERT INTO cookies VALUES (?, ?, ?, ?, ?, ?, ?)", extra_rows)
    db.commit()
    db.close()


@contextmanager
def fake_sso_server(
    *,
    code_ok=True,
    union_ok=True,
    callback_ok=True,
    probe_ok=True,
    get_code_redirect=False,
    unauthenticated_200=False,
    callback_cookie_path="/",
):
    encoded_redirect = base64.urlsafe_b64encode(
        urlencode({"client_id": "orders-app", "state": "trusted-state"}).encode("utf-8")
    ).decode("ascii").rstrip("=")
    state = {
        "paths": [],
        "code_form": set(),
        "code_headers": set(),
        "getcode_cookies": set(),
        "redirect_headers": set(),
        "redirect_cookies": set(),
        "target_cookies": set(),
        "union_form": {},
        "union_redirect": None,
        "probe_cookies": set(),
        "target_redirect": None,
    }

    class Handler(BaseHTTPRequestHandler):
        def log_message(self, _format, *_args):
            return

        def _cookie_names(self):
            return {
                item.partition("=")[0].strip()
                for item in self.headers.get("Cookie", "").split(";")
                if "=" in item
            }

        def _cookie(self, name):
            return name in self._cookie_names()

        def _redirect(self, path, cookie_name=None, cookie_value="<REDACTED>"):
            self.send_response(302)
            self.send_header("Location", path)
            if cookie_name:
                self.send_header("Set-Cookie", f"{cookie_name}={cookie_value}; Path=/; HttpOnly")
            self.end_headers()

        def do_GET(self):
            path = urlsplit(self.path).path
            state["paths"].append(path)
            if path == "/get-code-final":
                state["redirect_headers"] = {name.lower() for name in self.headers}
                state["redirect_cookies"] = self._cookie_names()
                self.send_response(200)
                self.send_header("Content-Type", "application/json")
                self.end_headers()
                self.wfile.write(b'{"code":0,"data":{"code":"<AUTH-CODE-SECRET>"}}')
                return
            if path == "/target":
                state["target_cookies"] = self._cookie_names()
                location = state["target_redirect"] or (
                    "/oidc/authorize?" + urlencode({
                        "client_id": "orders-app",
                        "redirect_uri": encoded_redirect,
                        "state": "trusted-state",
                    })
                )
                self._redirect(location, "analytics", ANALYTICS_COOKIE)
                return
            if path == "/oidc/authorize":
                self._redirect("/sso/login?" + urlencode({
                    "redirect_uri": encoded_redirect,
                    "state": "trusted-state",
                }))
                return
            if path == "/sso/login":
                self.send_response(200)
                self.end_headers()
                return
            if path == "/callback":
                if not callback_ok or not self._cookie("getcode_flow") or not self._cookie("sso.jd.com"):
                    self.send_response(403)
                    self.end_headers()
                    return
                self.send_response(200)
                self.send_header(
                    "Set-Cookie",
                    f"ssa.orders-app={TARGET_SESSION}; Path={callback_cookie_path}; HttpOnly",
                )
                self.end_headers()
                return
            if path == "/probe":
                state["probe_cookies"] = self._cookie_names()
                ok = all(self._cookie(name) for name in ("getcode_flow", "sso.jd.com", "ssa.orders-app"))
                self.send_response(200 if unauthenticated_200 or (ok and probe_ok) else 401)
                self.end_headers()
                return
            self.send_response(404)
            self.end_headers()

        def do_POST(self):
            length = int(self.headers.get("Content-Length", "0"))
            form = parse_qs(self.rfile.read(length).decode("utf-8"))
            path = urlsplit(self.path).path
            state["paths"].append(path)
            if path == "/get-code":
                state["code_form"] = set(form)
                state["code_headers"] = {name.lower() for name in self.headers}
                state["getcode_cookies"] = self._cookie_names()
                if get_code_redirect:
                    self.send_response(302)
                    self.send_header("Location", "/get-code-final")
                    self.send_header(f"Set-Cookie", f"getcode_flow={GETCODE_FLOW}; Path=/; HttpOnly")
                    self.end_headers()
                    return
                self.send_response(200 if self._cookie("me_token") and code_ok else 401)
                self.send_header("Content-Type", "application/json")
                self.send_header(f"Set-Cookie", f"getcode_flow={GETCODE_FLOW}; Path=/; HttpOnly")
                self.end_headers()
                payload = b'{"code":0,"data":{"code":"<AUTH-CODE-SECRET>"}}' if code_ok else b'{"code":1}'
                self.wfile.write(payload)
                return
            if path == "/jdme-union-login":
                state["union_form"] = form
                state["union_redirect"] = parse_qs(urlsplit(self.path).query).get("redirect_uri", [None])[0]
                if not union_ok or form.get("jme_auth_code") != [AUTH_CODE]:
                    self.send_response(401)
                    self.end_headers()
                    return
                if callback_ok:
                    self.send_response(302)
                    self.send_header("Location", "/callback")
                    self.send_header(f"Set-Cookie", f"sso.jd.com={SSO_TICKET}; Path=/; HttpOnly")
                    self.end_headers()
                else:
                    self.send_response(200)
                    self.send_header(f"Set-Cookie", f"sso.jd.com={SSO_TICKET}; Path=/; HttpOnly")
                    self.end_headers()
                return
            self.send_response(404)
            self.end_headers()

    server = ThreadingHTTPServer(("127.0.0.1", 0), Handler)
    thread = threading.Thread(target=server.serve_forever, daemon=True)
    thread.start()
    try:
        yield f"http://127.0.0.1:{server.server_port}", state
    finally:
        server.shutdown()
        thread.join()
        server.server_close()


def jdme_provider(base, db_path, cache_root, *, now=lambda: 1_000, probe=True, decryptor=None):
