{
  "name": "browser-forge",
  "version": "0.1.0",
  "main": "out/main/index.js",
  "scripts": {
    "build-native-tools": "node scripts/build-native-tools.mjs",
    "build": "npm run build-native-tools && electron-vite build",
    "build:private": "BROWSER_FORGE_TELEMETRY_BUILD=false npm run build",
    "build:telemetry": "BROWSER_FORGE_TELEMETRY_BUILD=true BROWSER_FORGE_SLS_HOST=cn-hangzhou.log.aliyuncs.com BROWSER_FORGE_SLS_PROJECT=browser-forge BROWSER_FORGE_SLS_LOGSTORE=main-trace npm run build",
    "dev": "node recorder.mjs",
    "package:mac": "npm run build && electron-forge package --platform=darwin",
    "package:mac:private": "npm run build:private && electron-forge package --platform=darwin",
    "package:mac:telemetry": "npm run build:telemetry && electron-forge package --platform=darwin",
    "make:mac": "npm run build && electron-forge make --platform=darwin",
    "make:mac:private": "npm run build:private && electron-forge make --platform=darwin",
    "make:mac:telemetry": "npm run build:telemetry && electron-forge make --platform=darwin",
    "test": "npm run build-native-tools && vitest run",
    "test:skill-generation": "vitest run tests/skill-generation",
    "test:watch": "vitest"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "chrome-remote-interface": "^0.34.0",
    "electron-vite": "^5.0.0",
    "express": "^5.2.1",
    "open": "^11.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-dmg": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^4.1.10",
    "electron": "^43.1.1",
    "playwright": "^1.61.1",
    "vite": "^6.4.3",
    "vitest": "^4.1.10"
  },
  "allowScripts": {},
  "type": "module"
}
